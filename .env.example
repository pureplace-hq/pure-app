# GitLab OAuth Configuration
# Get your client ID from: https://gitlab.com/-/profile/applications

VITE_GITLAB_CLIENT_ID=your-gitlab-application-id-here
VITE_GITLAB_URL=https://gitlab.com
VITE_GITLAB_REDIRECT_URI=http://localhost:5173/auth/gitlab/callback

# GitHub OAuth Configuration
# Create a GitHub App at: https://github.com/settings/apps
# Enable "Request user authorization (OAuth) during installation"
# No client secret needed - uses PKCE for public clients

VITE_GITHUB_CLIENT_ID=your-github-client-id-here
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback
